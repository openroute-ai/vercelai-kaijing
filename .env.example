# 开镜本地开发。复制为 .env 后填写。不要提交真实密钥。

# Postgres（根目录 docker compose 默认）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kaijing
DATABASE_SSL=auto
DATABASE_POOL_MAX=10

# better-auth
# BETTER_AUTH_URL 是 apps/web 运营后台。桌面用户的 better-auth 在 API 上，缺省用 API 自己的地址。
# CLOUD_AUTH_URL=http://127.0.0.1:8080
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:30051
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:30051,http://127.0.0.1:3020,http://localhost:8080

# 平台管理员种子：pnpm --filter @workspace/db db:seed:admin
PLATFORM_ADMIN_EMAIL=platform-admin@example.com
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=Platform Admin
PLATFORM_ADMIN_ORG_NAME=开镜平台

# Redis（短信验证码等）
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 邮件
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=hello@vercelai.cn
RESEND_API_KEY=

# 对象存储。本地开发可用 local。
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_URL=

# 文档站可选的检索模型。留空则相关功能不可用。
MISTRAL_API_KEY=

# 桌面壳在开发态加载的工作台地址
KAIJING_WORKSPACE_URL=http://127.0.0.1:3020

# 各应用端口
PORT=8080
NEXT_PUBLIC_BASE_URL=http://localhost:30051
NEXT_PUBLIC_API_URL=http://localhost:8080

# 开镜薄云作为 HTTP 客户端，调用现有 OpenRoute 生产网关。
# 不要把密钥提交进仓库。一把 sk- 平台密钥同时用于文本、图像和视频。
# 用户普通路径不必填写；高级设置可改用用户自己的 OpenRoute sk- 密钥。
OPENROUTE_API_URL=https://api.openroute.cn/v1
OPENROUTE_API_KEY=
# 也可使用下面的别名（与 OPENROUTE_* 共用一把密钥时只需填一处）
# KAIJING_API_BASE=https://api.openroute.cn/v1
# KAIJING_API_KEY=
# KAIJING_TEXT_MODEL=openai/gpt-4o-mini
# KAIJING_IMAGE_MODEL=qwen/qwen-image-plus
# KAIJING_VIDEO_MODEL=
