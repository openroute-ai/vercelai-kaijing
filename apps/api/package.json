{
  "name": "api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "description": "开镜薄云 OpenAPI：cloud 账户、积分和平台生成网关。",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=./.env src/index.ts",
    "test": "tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "build": "tsdown",
    "start": "node --env-file=./.env dist/index.mjs",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-openapi": "^1.2.4",
    "@hono/zod-validator": "^0.7.6",
    "@paralleldrive/cuid2": "^3.3.0",
    "@t3-oss/env-core": "^0.13.11",
    "@workspace/auth": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/drama-core": "workspace:*",
    "@workspace/providers": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.5",
    "pg": "^8.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "@types/pg": "^8.20.0",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "tsdown": "^0.21.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
