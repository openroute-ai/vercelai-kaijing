{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "API_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "BETTER_AUTH_URL",
    "DATABASE_POOL_MAX",
    "DATABASE_SSL",
    "DATABASE_URL",
    "KAIJING_WORKSPACE_URL",
    "MISTRAL_API_KEY",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_BASE_URL",
    "NEXT_PUBLIC_URL",
    "NODE_ENV",
    "PORT",
    "REDIS_DB",
    "REDIS_HOST",
    "REDIS_PASSWORD",
    "REDIS_PORT",
    "REDIS_URL",
    "RESEND_API_KEY",
    "SMTP_FROM",
    "SMTP_HOST",
    "SMTP_PASS",
    "SMTP_PORT",
    "STORAGE_ACCESS_KEY_ID",
    "STORAGE_BUCKET_NAME",
    "STORAGE_DRIVER",
    "STORAGE_ENDPOINT",
    "STORAGE_LOCAL_DIR",
    "STORAGE_SECRET_ACCESS_KEY",
    "UPSTASH_REDIS_REST_TOKEN",
    "UPSTASH_REDIS_REST_URL",
    "VERCEL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
